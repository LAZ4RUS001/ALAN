-- Income String Parser ($/s parser supporting 100k, 5M, 1B, with or without /s)
local function parseIncome(str)
    if type(str) == "number" then return str end
    if type(str) ~= "string" or str == "" then return 0 end
    local lower = string.lower(str)
    if lower == "all" or lower == "max" or lower == "inf" then
        return math.huge
    end
    str = string.gsub(str, "[,%$%s/sS]", "")
    local num, suffix = string.match(str, "^([%d%.]+)%s*([kKmMbBtT]?)$")
    if not num then return tonumber(str) or 0 end
    num = tonumber(num) or 0
    suffix = string.lower(suffix or "")
    if suffix == "k" then
        return num * 1e3
    elseif suffix == "m" then
        return num * 1e6
    elseif suffix == "b" then
        return num * 1e9
    elseif suffix == "t" then
        return num * 1e12
    end
    return num
end

