-- 9. Per-Account Background Save & Load System (Works on all executors with file API fallback)
local FOLDER_NAME = "PullADinoHub"
local CONFIG_FILE = FOLDER_NAME .. "/" .. tostring(LocalPlayer.UserId) .. ".json"

local function hasFileSystem()
    return (type(writefile) == "function" or type(write_file) == "function")
        and (type(readfile) == "function" or type(read_file) == "function")
end

local function safeWriteFile(path, content)
    local write = writefile or write_file
    if write then
        pcall(function() write(path, content) end)
    end
end

local function safeReadFile(path)
    local read = readfile or read_file
    if read then
        local ok, res = pcall(function() return read(path) end)
        if ok and res then return res end
    end
    return nil
end

local function safeMakeFolder(folder)
    local mkdir = makefolder or make_folder
    local isdir = isfolder or is_folder
    if mkdir then
        pcall(function()
            if isdir and not isdir(folder) then
                mkdir(folder)
            elseif not isdir then
                mkdir(folder)
            end
        end)
    end
end

local function safeIsFile(path)
    local check = isfile or is_file
    if check then
        local ok, res = pcall(function() return check(path) end)
        if ok then return res end
    end
    return false
end

local function saveConfig()
    if not hasFileSystem() then return end
    pcall(function()
        safeMakeFolder(FOLDER_NAME)
        local data = {
            AutoThrow = Config.AutoThrow,
            PerfectThrow = Config.PerfectThrow,
            AutoSell = Config.AutoSell,
            MaxSellIncome = Config.MaxSellIncome,
            EquipBest = Config.EquipBest,
            AutoGifts = Config.AutoGifts,
            AntiAFK = Config.AntiAFK
        }
        safeWriteFile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
end

local function loadConfig()
    if not hasFileSystem() then return end
    pcall(function()
        if safeIsFile(CONFIG_FILE) then
            local raw = safeReadFile(CONFIG_FILE)
            if raw then
                local decoded = HttpService:JSONDecode(raw)
                if type(decoded) == "table" then
                    for key, val in pairs(decoded) do
                        Config[key] = val
                    end
                    if decoded.MaxSellPrice and not decoded.MaxSellIncome then
                        Config.MaxSellIncome = decoded.MaxSellPrice
                    end
                end
            end
        end
    end)
end

