-- 6. Resilient Script Fetcher (Handles 302 redirects & HTTP drops on Mobile Executors)
local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request

local function FetchScript(url, maxRetries)
    maxRetries = maxRetries or 3
    for attempt = 1, maxRetries do
        if httpRequest then
            local reqOk, res = pcall(function()
                return httpRequest({
                    Url = url,
                    Method = "GET"
                })
            end)
            if reqOk and res and res.Body and #res.Body > 50 then
                return res.Body
            end
        end
        local ok, result = pcall(function()
            return game:HttpGet(url, true)
        end)
        if ok and result and #result > 50 then
            return result
        end
        task.wait(0.4)
    end
    return nil
end

