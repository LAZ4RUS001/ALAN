                local zoneText = getZoneInfo(reachStuds)
                throwReachLabel.Text = "Reach " .. tostring(reachStuds) .. " studs, " .. zoneText

                foodLabel.Text = "Food: " .. tostring(LocalPlayer:GetAttribute("Trail") or "Bacon")
                lastDinoLabel.Text = "Last: " .. tostring(CycleState.LastDino or "None")

                if CycleState.CurrentPhase == "Throw" then
