    -- Live UI Refresh Loop
    task.spawn(function()
        while Session.Running and card.Parent do
            task.wait(0.3)
            pcall(function()
                if CycleState.CurrentPhase == "Train" then
                    statusLabel.Text = "● training"
                    statusBadge.BackgroundColor3 = Color3.fromRGB(20, 48, 20)
                    badgeStroke.Color = Color3.fromRGB(35, 140, 45)
                    statusLabel.TextColor3 = Color3.fromRGB(60, 225, 80)
