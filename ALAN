-- 13. Auto Sell & Equip Best Worker (With Sell Protection Lock)
task.spawn(function()
    while Session.Running do
        task.wait(3)
        if Config.EquipBest and Remotes then
            pcall(function()
                Remotes.DinoAction:InvokeServer("EquipBest")
            end)
        end

        if Config.AutoSell and not isSelling and Remotes and SellZone then
            local maxIncome = parseIncome(Config.MaxSellIncome)
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")

            if root and Inventory and Inventory.Dinos then
                local toSell = {}
                local bestDinoIncome = LocalPlayer:GetAttribute("BestDinoIncome") or 0
                local totalBackpack = 0

                for id, dino in pairs(Inventory.Dinos) do
                    if (dino.Slot or 0) == 0 then
                        totalBackpack = totalBackpack + 1
                        local dinoIncome = ConfigShared.IncomeOf(dino, bestDinoIncome) or 0
                        if maxIncome == math.huge or maxIncome <= 0 or dinoIncome <= maxIncome then
                            table.insert(toSell, dino.Id or id)
                        end
                    end
                end

                if #toSell > 0 then
                    isSelling = true
                    local savedCF = root.CFrame

                    root.CFrame = CFrame.new(SellZone.Position.X, SellZone.Position.Y + 3, SellZone.Position.Z)
                    task.wait(0.3)

                    if maxIncome == math.huge or #toSell == totalBackpack then
                        pcall(function()
                            Remotes.DinoAction:InvokeServer("SellAll")
                        end)
                        task.wait(0.2)
                    else
                        for _, dinoId in ipairs(toSell) do
                            pcall(function()
                                Remotes.DinoAction:InvokeServer("Sell", dinoId)
                            end)
                            task.wait(0.1)
                        end
                        task.wait(0.15)
                    end

                    root.CFrame = savedCF
                    task.wait(0.2)
                    isSelling = false
                end
            end
        end
    end
end)

