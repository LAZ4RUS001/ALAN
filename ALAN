    local function createCustomSlider(titleText, defaultVal, posOffsetY, minVal, maxVal, onValChange)
        local sliderFrame = Instance.new("Frame", card)
        sliderFrame.Size = UDim2.new(1, 0, 0, 26)
        sliderFrame.Position = UDim2.new(0, 0, 0, posOffsetY)
        sliderFrame.BackgroundTransparency = 1

        local labelLeft = Instance.new("TextLabel", sliderFrame)
