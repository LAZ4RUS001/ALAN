-- 17. Floating Mobile Toggle Button (For Delta, Fluxus, Codex, Arceus X, Hydrogen)
local function CreateMobileToggleButton(win)
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "StreetHubMobileToggle"
    screenGui.ResetOnSpawn = false
    screenGui.DisplayOrder = 999999
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent = GetSafeGuiParent()

    local btn = Instance.new("TextButton")
    btn.Name = "ToggleIcon"
    btn.Size = UDim2.fromOffset(48, 48)
    btn.Position = UDim2.new(0, 30, 0.45, 0)
    btn.AnchorPoint = Vector2.new(0.5, 0.5)
    btn.BackgroundColor3 = Color3.fromRGB(18, 16, 22)
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Active = true
    btn.Parent = screenGui

    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(46, 168, 46)
    stroke.Thickness = 2.2
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local badgeContainer = Instance.new("Frame", btn)
    badgeContainer.Size = UDim2.fromScale(1, 1)
    badgeContainer.BackgroundTransparency = 1

    local dinoIcon = Instance.new("TextLabel", badgeContainer)
    dinoIcon.Size = UDim2.new(1, 0, 0, 20)
    dinoIcon.Position = UDim2.new(0, 0, 0, 6)
    dinoIcon.BackgroundTransparency = 1
    dinoIcon.Text = "🦖"
    dinoIcon.TextSize = 16
    dinoIcon.Font = Enum.Font.GothamBold

    local labelText = Instance.new("TextLabel", badgeContainer)
    labelText.Size = UDim2.new(1, 0, 0, 12)
    labelText.Position = UDim2.new(0, 0, 0, 26)
    labelText.BackgroundTransparency = 1
    labelText.Text = "HUB"
    labelText.TextColor3 = Color3.fromRGB(255, 255, 255)
    labelText.TextSize = 8
    labelText.Font = Enum.Font.GothamBold

    -- Mobile Touch & Mouse Dragging
    local dragging = false
    local dragInput, dragStart, startPos

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = btn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    btn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    -- Toggle Window visibility on tap
    local lastClick = 0
    btn.MouseButton1Click:Connect(function()
        if os.clock() - lastClick < 0.25 then return end
        lastClick = os.clock()
        pcall(function()
            if win.Minimize then
                win:Minimize()
            end
        end)
    end)

    return screenGui
end

