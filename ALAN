local function getZoneInfo(dist)
    for _, z in ipairs(ConfigShared.Zones or {}) do
        if dist >= (z.From or 0) and dist < (z.To or math.huge) then
            local span = (z.To - z.From)
            local progress = math.clamp((dist - z.From) / (span > 0 and span or 1), 0, 0.999)
            local totalSec = z.Sections or 3
            local sec = math.floor(progress * totalSec) + 1
            return z.Name .. " " .. sec .. "/" .. totalSec
        end
    end
    return "Mud 1/3"
end

