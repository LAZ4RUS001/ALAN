                local stationTier = LocalPlayer:GetAttribute("StationTier") or 1
                local station = ConfigShared.Training[stationTier]
                local stationName = station and station.Name or "Bar"
                local stationXp = station and station.Xp or 1
                local curXp = CycleState.CurXp or 0
                local needXp = ConfigShared.XpNeeded and ConfigShared.XpNeeded(trainLvl) or CycleState.NeedXp or 100
                if needXp <= 0 then needXp = 100 end

                local ratio = math.clamp(curXp / needXp, 0, 1)
                barFill.Size = UDim2.new(ratio, 0, 1, 0)

                levelLabel.Text = "Level " .. tostring(trainLvl)
                xpRatioLabel.Text = NumberFormat.short(curXp) .. " / " .. NumberFormat.short(needXp)

                detailBarLabel.Text = stationName .. ", " .. NumberFormat.short(stationXp) .. " XP a rep"

                local nextTargetLvl = trainLvl + 3
                local nextStuds = math.floor(nextTargetLvl * (station and station.PowerMult or 1) * 6 / 2)
                detailReachLabel.Text = "Level " .. tostring(nextTargetLvl) .. " reaches " .. tostring(nextStuds) .. " studs"

                detailX2Label.Text = tostring(CycleState.TotalX2Bonuses) .. " x2 bonuses"

                local power = LocalPlayer:GetAttribute("ThrowPower") or 0
